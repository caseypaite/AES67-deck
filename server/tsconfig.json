{
  "compilerOptions": {
    "target": "ES2020", "module": "CommonJS", "moduleResolution": "node",
    "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "strict": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
