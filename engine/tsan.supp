# ThreadSanitizer suppressions for the AES67-Deck engine.
#
# The engine's own cross-thread hand-offs through jack_ringbuffer are annotated
# with AES67_TSAN_RELEASE / AES67_TSAN_ACQUIRE (src/util/tsan_annotations.h), so
# TSan sees those happens-before edges directly and no suppression is needed for
# app code. What remains here is all third-party:

# jack_ringbuffer's own read/write-pointer atomics live in uninstrumented
# libjack; TSan attributes the data movement through the buffer to these.
race:jack_ringbuffer_read
race:jack_ringbuffer_write
race:jack_ringbuffer_read_space
race:jack_ringbuffer_write_space
race:jack_ringbuffer_read_advance
race:jack_ringbuffer_write_advance
race:jack_ringbuffer_reset

# Uninstrumented third-party libraries — TSan can't reason about their locking.
called_from_lib:libjack.so
called_from_lib:libpipewire-0.3.so
called_from_lib:liblilv-0.so
called_from_lib:libsndfile.so
called_from_lib:libwavpack.so
called_from_lib:calf.so
