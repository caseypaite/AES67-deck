# Dependencies
node_modules/

# Build output
engine/build/
engine/build-*/
ui/dist/
server/dist/

# Runtime state written by the running server (not source config)
server/patchbay_config.json
server/output_routing.json
server/talkback_config.json
server/mixer_state.json
server/fx_racks.json
server/vsc_config.json
server/loudness_config.json
server/timecode_config.json

# Saved DAW scenes (user session data)
scenes/*.json

# DAW projects — arrangement JSON + recorded take audio (user session data)
projects/

# Playout playlists (user session data)
playlists/

# REAPER-compatible multitrack recording projects (.rpp + consolidated media)
records/

# As-run logs: loudness CSV + exported compliance reports (Phase 3c)
logs/

# Browser smoke test: run artifacts (browser lives in node_modules, already ignored)
test/browser/.work/

# Throwaway test rigs / experiments
scratchpad/

# Editor / OS
.DS_Store
*.swp
server/tx_sources.json
server/rx_sinks.json

# TS incremental build info
*.tsbuildinfo
