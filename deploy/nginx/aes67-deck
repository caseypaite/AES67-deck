# AES67-Deck operator UI — static SPA. Talks directly to ws://<host>:8081.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/aes67-deck;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # hashed assets — long cache
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    access_log /var/log/nginx/aes67-deck.access.log;
    error_log  /var/log/nginx/aes67-deck.error.log;
}
